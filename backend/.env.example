APP_ENV=development
HOST=127.0.0.1
PORT=8000
LLM_PROVIDER=fake
LLM_FALLBACK_PROVIDER=none
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_MS=250
LLM_RETRY_MAX_DELAY_MS=2000
LLM_RETRY_JITTER_RATIO=0.2
CHAT_RATE_LIMIT_MAX_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_CACHE_TTL_MS=0
INGESTION_MAX_FILE_BYTES=1000000
OPENAI_INPUT_USD_PER_1M_TOKENS=0
OPENAI_OUTPUT_USD_PER_1M_TOKENS=0
OPENAI_THINKING_USD_PER_1M_TOKENS=0
GEMINI_INPUT_USD_PER_1M_TOKENS=0
GEMINI_OUTPUT_USD_PER_1M_TOKENS=0
GEMINI_THINKING_USD_PER_1M_TOKENS=0

# Công cụ filesystem chỉ được phép hoạt động trong các thư mục gốc, phân tách bằng dấu chấm phẩy.
# Ví dụ: FILE_TOOL_ALLOWED_ROOTS=E:\Project\3sdesign
FILE_TOOL_ALLOWED_ROOTS=
FILE_TOOL_ALLOW_WRITE=false
FILE_TOOL_ALLOW_DELETE=false
FILE_AGENT_AUTO_APPLY_WRITES=false
FILE_TOOL_MAX_FILE_BYTES=1000000

# Tuỳ chọn: bật lưu hội thoại bền vững khi được cấu hình.
# Ví dụ: postgres://postgres:postgres@127.0.0.1:5432/ai_learning
DATABASE_URL=
DATABASE_SSL=false
DATABASE_RUN_MIGRATIONS=false

# Chỉ bắt buộc khi LLM_PROVIDER=openai hoặc LLM_FALLBACK_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Chỉ bắt buộc khi LLM_PROVIDER=gemini hoặc LLM_FALLBACK_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Chỉ dùng cho script tham khảo: npm run reference:azure-foundry-agent -- "câu lệnh của bạn"
# Ví dụ base URL: https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1/
AZURE_FOUNDRY_OPENAI_BASE_URL=
AZURE_FOUNDRY_OPENAI_API_KEY=
AZURE_FOUNDRY_OPENAI_DEPLOYMENT=
