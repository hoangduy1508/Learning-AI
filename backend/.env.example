APP_ENV=development
LLM_PROVIDER=fake
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_MS=250
LLM_RETRY_MAX_DELAY_MS=2000
LLM_RETRY_JITTER_RATIO=0.2

# Filesystem tools are only allowed inside these semicolon-separated roots.
# Example: FILE_TOOL_ALLOWED_ROOTS=E:\Project\3sdesign
FILE_TOOL_ALLOWED_ROOTS=
FILE_TOOL_ALLOW_WRITE=false
FILE_TOOL_ALLOW_DELETE=false
FILE_AGENT_AUTO_APPLY_WRITES=false
FILE_TOOL_MAX_FILE_BYTES=1000000

# Optional: enables persistent chat conversations when set.
# Example: postgres://postgres:postgres@127.0.0.1:5432/ai_learning
DATABASE_URL=
DATABASE_SSL=false
DATABASE_RUN_MIGRATIONS=false

# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Required only when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Reference script only: npm run reference:azure-foundry-agent -- "your prompt"
# Example base URL: https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1/
AZURE_FOUNDRY_OPENAI_BASE_URL=
AZURE_FOUNDRY_OPENAI_API_KEY=
AZURE_FOUNDRY_OPENAI_DEPLOYMENT=
